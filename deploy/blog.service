[Unit]
Description=Portfolio Blog Backend (FastAPI)
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/blog/backend
ExecStart=/opt/blog/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
